{
  "version": 2,
  "builds": [
    {
      "src": "api/google-drive.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/google-drive.js"
    },
    {
      "src": "/(.*)",
      "dest": "/dist/index.html"
    }
  ],
  "rewrites": [
    {
      "/api/(.*)": "/api/google-drive.js"
    }
  ]
}